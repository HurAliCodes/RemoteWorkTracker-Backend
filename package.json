{
  "name": "nodejs-app",
  "version": "1.0.0",
  "description": "Node.js Express application boilerplate",
  "main": "src/server.ts",
  "scripts": {
    "start": "node init && ts-node src/server.ts",
    "dev": "node init && nodemon src/server.ts",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "seed": "ts-node scripts/seed.ts",
    "clear:seeded-ptg": "ts-node scripts/clear-seeded-projects-tasks-goals.ts",
    "clear:seeded-enrollments": "ts-node scripts/clear-seeded-course-enrollments.ts",
    "migrate": "ts-node scripts/migrate.ts",
    "migrate:tasks-deadline": "npm run migrate",
    "migrate:idle_logs": "npm run migrate",
    "worker:ai": "ts-node src/ai.worker.ts",
    "worker:ai:dev": "nodemon src/ai.worker.ts",
    "test": "jest",
    "test:ai": "jest src/modules/ai/ --no-cache",
    "check:ai": "ts-node scripts/check-ai-connection.ts",
    "smoke:seeded": "ts-node scripts/smoke-seeded-apis.ts",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "check": "npm run lint && npm test",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/pg": "^8.18.0",
    "amqplib": "^1.0.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.5",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
