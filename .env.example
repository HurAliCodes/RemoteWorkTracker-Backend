# Copy to `.env`. On Vercel, set the same keys in Project → Settings → Environment Variables.

# Local:
# NODE_ENV=development
# PORT=5000
# FRONTEND_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Production (Vercel API + Next.js web):
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://remote-tracker-web-eight.vercel.app
CORS_ORIGIN=https://remote-tracker-web-eight.vercel.app
TRUST_PROXY=1

DATABASE_URL=
DB_SSL=true
JWT_SECRET=
JWT_REFRESH_SECRET=

# Must match ai-server SERVICE_CLIENT_ID / SERVICE_CLIENT_SECRET
AI_SERVER_BASE_URL=
AI_SERVICE_CLIENT_ID=portal-backend
AI_SERVICE_CLIENT_SECRET=change-me
AI_DEFAULT_SCOPES=analytics:write analytics:read
AI_TOKEN_TTL_SAFETY_SECONDS=60
AI_SNAPSHOT_POLICY_START_HOUR_UTC=9
AI_SNAPSHOT_POLICY_END_HOUR_UTC=18
AI_SNAPSHOT_ROLLUP_DAYS=30
AI_SNAPSHOT_LATE_GRACE_MINUTES=60

# Optional: email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Optional FCM (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional Redis / RabbitMQ
REDIS_URL=
RABBITMQ_URL=
